# Backend — nunca copiar chaves privilegiadas para apps/web ou NEXT_PUBLIC_*.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Pooler Session, porta 5432. Codifique caracteres especiais da senha na URL.
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@SEU-POOLER:5432/postgres
STORAGE_BUCKET_UPLOADS=uploads
STORAGE_BUCKET_REPORTS=reports
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3100
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_JOB_MAX_ATTEMPTS=3
LOG_LEVEL=INFO
# Opcional. Sem chave, mapeamento assistido por heurística e relatórios determinísticos.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=CONFIGURE_UM_MODELO_DISPONIVEL_NA_SUA_CONTA

# Frontend — copiadas por make web-env (apenas estas três variáveis públicas).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
