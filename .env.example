# Copie para .env e preencha. Nenhuma chave vai para o código.

# --- Supabase (valores locais: rode `supabase status` para ver os seus) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Conexão Postgres direta usada pelo worker (fila com SKIP LOCKED).
# Dentro do docker-compose o host é host.docker.internal.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
STORAGE_BUCKET_UPLOADS=uploads
STORAGE_BUCKET_REPORTS=reports

# --- Anthropic (mapeamento de colunas e redação do relatório) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Worker ---
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_JOB_MAX_ATTEMPTS=3
LOG_LEVEL=INFO

# --- Frontend (apps/web) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
