# Copie para .env e preencha. Nenhuma chave vai para o código.
# Desenvolvimento usa o projeto Supabase na nuvem (sem Docker local).

# --- Supabase (Project Settings > API e Database) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Connection string Postgres do worker (fila com SKIP LOCKED); use o pooler em modo session.
DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@<host-do-pooler>:5432/postgres
STORAGE_BUCKET_UPLOADS=uploads
STORAGE_BUCKET_REPORTS=reports

# --- Anthropic (mapeamento de colunas e redação do relatório) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Worker ---
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_JOB_MAX_ATTEMPTS=3
LOG_LEVEL=INFO

# --- Frontend (apps/web) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
